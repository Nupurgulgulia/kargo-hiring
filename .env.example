# Neon Postgres (project dry-bird-77072578, branch production). `neon link` / `neon env pull`
# writes these into .env.local. The app uses the pooled URL; `npm run db:setup` uses the direct one.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Google AI Studio → Get API key
GEMINI_API_KEY=
# Optional: pin a specific Flash model, e.g. gemini-2.5-flash. Defaults to the latest Flash alias.
GEMINI_MODEL=gemini-flash-latest
# Optional: used after repeated 503/429 overload errors on GEMINI_MODEL (e.g. another Flash model). Unset = no fallback.
GEMINI_FALLBACK_MODEL=

# Resend → API Keys
RESEND_API_KEY=
# Must be on a domain verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM=Arjun Mehta <onboarding@resend.dev>
EMAIL_REPLY_TO=
# Test mode: when set, EVERY send goes to this address instead of the candidate (subject unchanged;
# the intended recipient is logged) and the draft stays unsent. Remove it before emailing real candidates.
EMAIL_TEST_RECIPIENT=
# true = email rejections automatically when scoring finishes (invites always wait for a click).
# Unset or false = every email waits for Arjun's click.
AUTO_SEND_REJECTIONS=

# Password Arjun uses to sign in to the dashboard
DASHBOARD_PASSWORD=
# Any long random string; signs the session cookie
AUTH_SECRET=
