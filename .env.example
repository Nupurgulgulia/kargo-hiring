# Supabase (project: mesa-ai-track, tables prefixed kargo_)
SUPABASE_URL=https://hwwolosgysvxuxbuzkuy.supabase.co
# Supabase dashboard → Project Settings → API Keys → secret / service_role key. Server-only.
